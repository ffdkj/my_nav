# --- deps / build ---
node_modules/
/dist/
/build/
.vite/
*.tsbuildinfo

# 前端产物由 go:embed 消费（CI/Docker 会重新构建），只保留占位文件。
# 注意：必须用 internal/web/dist/* 而不是裸的 dist/，
# 否则目录本身被排除后，! 规则无法把它里面的 .gitkeep 救回来。
internal/web/dist/*
!internal/web/dist/.gitkeep

# --- Go ---
/bin/
*.test
*.out
coverage.*

# --- 本地运行时数据（绝不入库）---
/data/
*.db
*.db-wal
*.db-shm

# --- env / secrets ---
.env
.env.*
!.env.example

# --- editor / OS ---
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# --- 工具链与本地缓存 ---
# .tools 放 sqlc 等开发期二进制（make tools 自动下载，约 56MB，不入库）
.tools/
.npm-cache/
.gocache/
.gomodcache/
.gopath/

# --- e2e（脚本入库；依赖、浏览器与截图不入库）---
e2e/node_modules/
e2e/browsers/
e2e/*.png
# 早期版本的截图目录（已废弃，仅用于确认清理干净）
.e2e/

# --- 临时/验证目录 ---
.scratch/
.smoke/
.research/
_research_verify/
